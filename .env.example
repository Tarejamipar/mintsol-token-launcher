# Public address that receives the 0.02 SOL platform fee. Never put secrets here.
VITE_PLATFORM_FEE_WALLET=

# Keep devnet while testing. Change to mainnet-beta only when ready.
VITE_SOLANA_CLUSTER=devnet

# Server-side only for the Vercel API upload function. Never use the VITE_ prefix.
# Enter the real value only in Vercel Environment Variables or an ignored local .env.
PINATA_JWT=

# Optional exact origin allowed to call /api/upload. Defaults to the production Vercel URL.
APP_ORIGIN=

# Optional shared cross-instance upload rate limiting (Upstash Redis REST).
# Set both values in Vercel to enable shared enforcement; never expose these to the client.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
